# Copy to .env.deployment and provide real deployment values via a secret manager.
# Never commit the populated file or expose backend values as VITE_* variables.
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg2://...
DATABASE_URL_UNPOOLED=postgresql+psycopg2://...
JWT_SECRET_KEY=
SECRET_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://...
AWS_REGION=us-east-1
NEON_STORAGE_BUCKET=
# Optional public endpoint used to sign browser downloads; leave empty to use AWS_ENDPOINT_URL_S3.
AWS_PUBLIC_ENDPOINT_URL_S3=
ALLOWED_ORIGINS=https://your-public-site.example
VITE_API_URL=https://your-api.example
ADMIN_EMAIL=
ADMIN_PASSWORD=
CONTACT_RATE_LIMIT=20/hour
LOGIN_RATE_LIMIT=5/minute
ANALYTICS_RATE_LIMIT=60/minute
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_NOTIFICATION_TO=
CONTACT_NOTIFICATION_DRY_RUN=false
TRUST_CLOUDFLARE_CLIENT_IP=false
# Optional local reverse-proxy ports; Compose binds them to loopback only.
API_PORT=8002
FRONTEND_PORT=3001
