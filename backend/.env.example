# Example variables only; no credentials are included. Add local values to the ignored backend/.env before running the backend directly.
ENVIRONMENT=development
DATABASE_URL=
JWT_SECRET_KEY=
SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://portfolio.local
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
LOGIN_RATE_LIMIT=5/minute
CONTACT_RATE_LIMIT=5/hour
ANALYTICS_RATE_LIMIT=60/minute
# Resend contact notifications. Set a verified sender and notification recipient.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_NOTIFICATION_TO=
# Enable only on Render, where CF-Connecting-IP is overwritten by its edge proxy.
TRUST_CLOUDFLARE_CLIENT_IP=false
PROJECTS_SEED_JSON=[]
SKILLS_SEED_JSON=[]
