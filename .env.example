# Example variables only; no credentials are included. Set required values in
ENVIRONMENT=development
# PostgreSQL container password. Compose uses it to construct its internal DATABASE_URL.
POSTGRES_PASSWORD=
# Host ports published by Compose; change them if these ports are occupied.
POSTGRES_PORT=5432
API_PORT=8002
FRONTEND_PORT=3001
# Local backend/seed URL outside Compose. Compose supplies its internal service URL.
DATABASE_URL=
# Optional Neon Object Storage credentials for the backend. Keep these server-side.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
NEON_STORAGE_BUCKET=uploads
# Optional unpooled PostgreSQL URL used by Alembic migrations (Neon production).
DATABASE_URL_UNPOOLED=
LOGIN_RATE_LIMIT=5/minute
CONTACT_RATE_LIMIT=5/hour
ANALYTICS_RATE_LIMIT=60/minute
# Access-token signing secret; use a unique random value of 32+ characters in production.
JWT_SECRET_KEY=
# Application signing secret; keep distinct from JWT_SECRET_KEY.
SECRET_KEY=
# Initial administrator credentials for backend/scripts/seed.py; never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Comma-separated browser origins allowed by backend CORS.
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000
# Public API URL, compiled into the frontend image at build time.
VITE_API_URL=http://localhost:8002
VITE_APP_NAME=Portfolio
VITE_ENVIRONMENT=development
# Optional JSON arrays for repeatable project/skill initialization.
PROJECTS_SEED_JSON=[]
SKILLS_SEED_JSON=[]


